# growbot configuration
# Copy this file to .env and fill in the values for local development.
# All values are read from the process environment; .env is loaded
# best-effort at startup and is optional.

# Base URL of the Misskey instance (must start with http:// or https://).
# May be left empty for smoke runs that do not contact Misskey.
# Example: https://misskey.example.com
MISSKEY_BASE_URL=

# Bot account API token used to authenticate with Misskey.
MISSKEY_TOKEN=

# Path to the SQLite database file.
# Default: ./bot.db
DB_PATH=./bot.db

# Minimum log level: debug | info | warn | error
# Default: info
LOG_LEVEL=info

# Log output format: text | json
# Default: text
LOG_FORMAT=text

# --- Phase 1: generation / learning ---

# N-gram order of the Markov model (clamped to >= 2).
# Lower (2) mixes vocabulary more; higher (3) is more coherent but needs more data.
# Default: 2
MARKOV_ORDER=2

# How often the bot autonomously posts a generated note (Go duration, e.g. 30m, 2h).
# Default: 30m
POST_INTERVAL=30m

# Minimum / maximum token length of a generated sentence.
# Defaults: 3 / 40
MIN_SENTENCE_TOKENS=3
MAX_SENTENCE_TOKENS=40

# Skip learning from notes shorter than this many tokens.
# Default: 2
LEARN_MIN_TOKENS=2

# Which timeline the bot learns from: local | global | hybrid | home.
# On a near-single-user instance the local timeline is almost empty, so
# "global" (federated public notes) gives the bot far more to learn from.
# Note: global/hybrid ingest unmoderated, multilingual federated content, so
# consider populating NG_WORDS (below) when learning from them.
# Default: local
LEARN_TIMELINE=local

# Toggle self-initiated posting: true | false
# Default: true
AUTONOMOUS_POST=true

# --- Phase 2: psyche (will) / biorhythm (life rhythm) ---

# How often the internal life loop updates drives/mood/energy (Go duration).
# Default: 1m
TICK_INTERVAL=1m

# Time zone the local-hour biorhythm is interpreted in (standard TZ env var).
# tzdata is embedded in the binary, so this works even in a minimal container.
# Unset = UTC. Example: Asia/Tokyo
# TZ=Asia/Tokyo

# Sleep window in local hours (0..23, half-open [start,end), wraps past midnight).
# The bot stays silent and recovers energy while asleep.
# Defaults: 1 / 7
SLEEP_START_HOUR=1
SLEEP_END_HOUR=7

# Aggregate drive pressure (0..1) required before the bot speaks on its own.
# Higher = more reticent. POST_INTERVAL still caps how often it can post.
# Default: 0.55
URGE_THRESHOLD=0.55

# --- Phase 3: memory (forgetting / consolidation / dreams) ---

# Strength multiplier applied to chains not heard since the last consolidation
# (the forgetting curve), in (0,1]. Lower = forgets faster.
# Default: 0.9
MEMORY_DECAY=0.9

# Strength added to chains heard recently (reinforcement), >= 0.
# Default: 0.1
MEMORY_REINFORCE=0.1

# Chains whose strength falls below this are pruned, in [0,1).
# Default: 0.05
MEMORY_PRUNE_BELOW=0.05

# Minimum time between sleep-time consolidations (Go duration).
# Default: 12h
CONSOLIDATE_MIN_INTERVAL=12h

# Probability (0..1) of posting a dream on waking.
# Default: 0.3
DREAM_CHANCE=0.3

# --- Phase 4: relationships (social) / mentions ---

# Reply to mentions and replies: true | false
# Default: true
MENTION_REPLY=true

# How much affinity (closeness) rises per interaction with an actor, in [0,1].
# Higher affinity makes replies warmer in tone.
# Default: 0.1
AFFINITY_GAIN=0.1

# --- Phase 5: growth (lifecycle / habit / engagement learning) ---

# How often the bot polls its own posts for engagement (Go duration).
# Default: 5m
ENGAGEMENT_POLL_INTERVAL=5m

# How long to wait after a post before scoring its engagement (Go duration).
# Default: 30m
REACTION_DELAY=30m

# Minimum vocabulary frequency for a token to seed a topical post / catchphrase.
# Default: 3
TOPIC_MIN_FREQ=3

# Probability (0..1) of appending the bot's emergent catchphrase to a post.
# Default: 0.2
CATCHPHRASE_CHANCE=0.2

# How long after a post the bot gives up scoring it (must exceed REACTION_DELAY).
# Prevents a permanently-unfetchable note from starving the scoring queue.
# Default: 24h
ENGAGEMENT_GIVEUP=24h

# --- Phase 6: safety / operations ---

# Comma-separated forbidden substrings. A post or learned note containing one is
# suppressed. Default: empty (no NG words).
NG_WORDS=

# Suppress text whose symbol/punctuation ratio exceeds this, in [0,1].
# Default: 0.5
MAX_SYMBOL_RATIO=0.5

# Hard cap on posts per rolling hour (0 disables the cap).
# Default: 12
MAX_POSTS_PER_HOUR=12

# Affinity threshold above which an actor counts as a "friend" in growth metrics, [0,1].
# Default: 0.3
FRIEND_AFFINITY=0.3
